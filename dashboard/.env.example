# Copy to .env.local (gitignored) and fill in. All values are read on the
# server only -- nothing here is sent to the browser.

# --- Datenquelle A: das Python-Backend (backend/server.py) -----------------
# URL des Backends und dessen APP_TOKEN. Ist SORAREBUDDY_API_URL leer, liest
# das Dashboard stattdessen lokale JSON-Dateien (Datenquelle B).
SORAREBUDDY_API_URL=
SORAREBUDDY_API_TOKEN=
SORAREBUDDY_SLUG=nicktd7
SORAREBUDDY_RARITIES=limited

# --- Datenquelle B: lokale Dateien -----------------------------------------
# Verzeichnis mit lineups.json, club.json, logs/evaluation.json,
# calibration.json, logs/lineup_review.json. Standard: das Repo (..).
# SORAREBUDDY_DATA_DIR=..

# --- Zugriffsschutz --------------------------------------------------------
# Pflicht, sobald das Dashboard irgendwo erreichbar gehostet wird
# (zeigt Account-Daten). Leer = kein Passwort (nur lokal!).
DASHBOARD_USER=nick
DASHBOARD_PASSWORD=
