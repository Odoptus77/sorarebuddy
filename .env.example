# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must never be committed.

# Required: your Sorare API key (from https://sorare.com -> Settings -> API)
SORARE_API_KEY=your_api_key_here

# Optional: only needed for authenticated actions that require a JWT
# (e.g. accessing your own private account data / signing).
# SORARE_EMAIL=you@example.com
# SORARE_PASSWORD=your_password
