# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and must never be committed.

# Required: your Sorare API key (from https://sorare.com -> Settings -> API)
SORARE_API_KEY=your_api_key_here

# Optional: OAuth login to access your OWN account data (your cards / club).
# See docs/oauth-setup.md. Create the app at sorare.com/settings/developer.
# SORARE_CLIENT_ID=your_oauth_client_id
# SORARE_CLIENT_SECRET=your_oauth_client_secret
# SORARE_REDIRECT_URI=http://localhost:3000/auth/sorare/callback
# Filled in after the token exchange (python3 sorare_client.py token <code>):
# SORARE_ACCESS_TOKEN=your_access_token
