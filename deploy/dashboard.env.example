# Copy to /etc/sorarebuddy/dashboard.env on the VPS (install-dashboard.sh does
# this once). chmod 600. Loaded by systemd -- no export, no quotes.

# The backend on the same machine (loopback, never over the internet).
SORAREBUDDY_API_URL=http://127.0.0.1:8080
# = APP_TOKEN from /etc/sorarebuddy/env
SORAREBUDDY_API_TOKEN=replace_with_APP_TOKEN
SORAREBUDDY_SLUG=nicktd7
SORAREBUDDY_RARITIES=limited
# a cold pipeline run can take minutes
SORAREBUDDY_TIMEOUT_MS=600000

# Login for the dashboard (HTTP Basic Auth). REQUIRED -- it shows account data.
# Generate a password:  openssl rand -base64 18
DASHBOARD_USER=nick
DASHBOARD_PASSWORD=replace_me
