# Copy to /etc/sorarebuddy/env on the VPS and fill in. chmod 600.
# systemd loads this via EnvironmentFile — no export, no quotes needed.

# Your Sorare API key (stays on the server, never in the app/artifact).
SORARE_API_KEY=sr128_replace_me

# Shared secret the app/dashboard must send as "Authorization: Bearer <token>".
# Generate one:  openssl rand -hex 24
APP_TOKEN=replace_with_random_hex

# Manager slug used when a request omits ?slug=
DEFAULT_SLUG=nicktd7

# Bind loopback only — Caddy/nginx terminates TLS and proxies to it.
BIND=127.0.0.1
PORT=8080

# Cache: how long results stay "fresh" (seconds) and where they live.
CACHE_TTL=1800
CACHE_DIR=/var/lib/sorarebuddy/cache

# Max seconds for one pipeline run (a cold rewards scan is slow).
JOB_TIMEOUT=600
